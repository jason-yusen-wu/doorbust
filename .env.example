GOOSE_DBSTRING=postgres://user:password@ep-xxxx.region.aws.neon.tech/doorbust?sslmode=require
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./internal/adapters/postgresql/migrations
COGNITO_ISSUER_URL=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_CLIENT_ID=<app-client-id>

# Stripe (test mode). Both are required — the app panics at boot without them,
# rather than failing every checkout at runtime.
#
# On the EC2 box these are NOT set here: put them in SSM as SecureString and
# render-doorbust-env.sh picks them up automatically, like GOOSE_DBSTRING —
#   aws ssm put-parameter --name /doorbust/STRIPE_SECRET_KEY --type SecureString --value 'sk_test_...'
#   aws ssm put-parameter --name /doorbust/STRIPE_WEBHOOK_SECRET --type SecureString --value 'whsec_...'
#
# Stripe cannot reach the box (one /32 in the security group, no Elastic IP,
# no domain, no TLS), so the deployed app PULLS events from Stripe's API
# instead of receiving webhooks. Nothing needs configuring on Stripe's side.
#
# STRIPE_WEBHOOK_SECRET is therefore only needed for local development, where
# `stripe listen --forward-to localhost:8080/webhooks/stripe` pushes to the
# webhook endpoint. It is still required at boot; any placeholder works if you
# are relying on polling.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_CURRENCY=usd

# Event poller. Set the interval to 0 to disable it (what a local run using
# `stripe listen` wants). The overlap re-scans a window behind the cursor and
# is NOT optional padding: the cursor is a timestamp, not a sequence, so
# without it an out-of-order event is skipped permanently. Re-scanning is free
# because inserts dedup on Stripe's own event id.
# STRIPE_EVENT_POLL_INTERVAL=10s
# STRIPE_EVENT_POLL_OVERLAP=2m
# STRIPE_EVENT_INITIAL_LOOKBACK=1h

# Cognito group whose members may POST /products. Must match the group that
# actually exists in the pool (Terraform creates it). If it doesn't match,
# nobody is a vendor — the failure mode is closed, never open.
# COGNITO_VENDOR_GROUP=vendors

# Reservation expiry. Ours, not Stripe's: stock must come back on sale even if
# the processor never calls back.
# RESERVATION_TTL=15m
# RESERVATION_SWEEP_INTERVAL=1m
# RESERVATION_SWEEP_BATCH=100

# Stripe webhook outbox worker.
# STRIPE_POLL_INTERVAL=5s
# STRIPE_MAX_ATTEMPTS=5

# How long in-flight requests get to finish on SIGTERM (deploy restart).
# SHUTDOWN_TIMEOUT=15s

# The storefront. In production the bundle is baked into the container image
# and served from this process at the same origin, so:
#
#   - WEB_DIST_DIR is set to /srv/web by the Dockerfile. Locally it defaults to
#     ./web/dist; a missing directory just means the API serves without a UI.
#     The directory is opened at startup but files are read per request, so
#     `npm run build` against a running server is picked up without a restart.
#     Only deleting and recreating the directory (rm -rf dist) needs one.
#   - CORS_ALLOWED_ORIGINS stays EMPTY in production. Nothing is cross-origin
#     when the same process serves both halves. Empty means the middleware is
#     not mounted at all — closed by default.
#
# Set the origins only when running Vite separately (`npm run dev` on :5173).
# Comma-separated; unquoted, like every value in this file.
# WEB_DIST_DIR=./web/dist
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting. Both default to 0, which disables it — an upgrade must not
# start rejecting traffic nobody asked it to reject, and a benchmark must
# measure the reserve path rather than the limiter. Per-subject is usually the
# tighter of the two, since an office or household may share one address.
# RATE_LIMIT_PER_IP_RPS=50
# RATE_LIMIT_PER_SUBJECT_RPS=10
# RATE_LIMIT_BURST=20
# RATE_LIMIT_IDLE=10m

# Idempotency for POST /orders. On by default: without it a retry reserves a
# second unit. Callers that send no Idempotency-Key are unaffected either way.
# ORDER_IDEMPOTENCY=true

# Which reserve strategy to run — baseline, reserve-last or cte. See the
# benchmark results in bench/results/ and Track B in CLAUDE.md. An unrecognised
# name is a boot panic rather than a silent fallback.
# RESERVE_STRATEGY=baseline
# CUSTOMER_CACHE=false

# Listen address, and whether to mount chi's per-request logger. LOG_REQUESTS
# is off only for measurement runs: it is a mutex-serialised write to stdout on
# every request, which is a global lock on the path being measured.
# ADDR=:8080
# LOG_REQUESTS=true

# Connection pool.
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5
# DB_MIN_IDLE_CONNS=5
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
