# Copy to web/.env for `npm run dev`. In production none of this file is used:
# the Dockerfile passes the same names as build args, because Vite inlines them
# into the bundle at build time rather than reading them at runtime.
#
# Nothing here is a secret. A Cognito domain, a public app client id and a
# Stripe *publishable* key are all values the browser holds anyway. The Stripe
# secret key and the database DSN live in SSM and never appear in a build.

# Empty in production — the Go server serves this bundle, so the API is on the
# same origin. For `npm run dev`, point it at the API and set
# CORS_ALLOWED_ORIGINS=http://localhost:5173 on the server side to match.
VITE_API_BASE_URL=http://localhost:8080

# Cognito Hosted UI. The app client MUST be created WITHOUT a client secret —
# this is a public SPA using authorization code + PKCE, and Cognito rejects the
# token exchange for a confidential client that sends no secret.
#
# Register both callback URLs on the app client:
#   http://localhost:5173/auth/callback   (dev)
#   http://<box-ip>:8080/auth/callback    (the deployed box)
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<public-app-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Stripe test-mode publishable key (pk_test_...), the counterpart to the
# STRIPE_SECRET_KEY the server holds.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Development escape hatch: adds a "paste an ID token" form to /signin so the
# app can be driven end-to-end before the Hosted UI above exists. Get a token
# with scripts/get-test-token.sh. This folds to a constant false in a
# production build, so the form is removed by the bundler, not merely hidden.
VITE_ENABLE_DEV_TOKEN_LOGIN=true
