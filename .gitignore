.env
CONTEXT.md

# terraform — state holds the generated SSH private key in plaintext, and
# tfvars holds your IP/config, so keep both out of the repo everywhere, not
# just under infra/.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
infra/deploy_key
infra/deploy_key.pub

# Benchmark binaries. Results under bench/results/ ARE committed — the README
# quotes them, so they have to be auditable.
bin/

# Generated for demo filming; derived from web/.env.
web/.env.demo
